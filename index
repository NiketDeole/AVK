    function generateNextMemberId(gender) {
      const prefix = gender === "bride" ? "AVK-B-" : "AVK-G-";
      let maxNum = 100;
      state.profiles.forEach((p) => {
        if (p.id && p.id.startsWith(prefix)) {
          const n = parseInt(p.id.replace(prefix, ""), 10);
          if (!isNaN(n) && n > maxNum) maxNum = n;
        }
      });
      return `${prefix}${maxNum + 1}`;
    }

    function saveProfileFromModal(e) {
      e.preventDefault();
      const editId = document.getElementById("pfEditId").value;
      const gender = document.getElementById("pfGender").value;

      const data = {
        name: document.getElementById("pfName").value.trim(), gender,
        age: Number(document.getElementById("pfAge").value),
        village: document.getElementById("pfVillage").value.trim(),
        maritalStatus: document.getElementById("pfMaritalStatus").value,
        education: document.getElementById("pfEducation").value.trim(),
        income: document.getElementById("pfIncome").value.trim(),
        registeredAt: document.getElementById("pfRegisteredAt").value,
        religion: document.getElementById("pfReligion").value.trim(),
        caste: document.getElementById("pfCaste").value.trim(),
        height: document.getElementById("pfHeight").value.trim(),
        occupation: document.getElementById("pfOccupation").value.trim(),
        language: document.getElementById("pfLanguage").value.trim(),
        about: document.getElementById("pfAbout").value.trim(),
        mobile: document.getElementById("pfMobile").value.trim(),
        parentPhone: document.getElementById("pfParentPhone").value.trim(),
        email: document.getElementById("pfEmail").value.trim(),
        fullAddress: document.getElementById("pfFullAddress").value.trim(),
        paymentRef: document.getElementById("pfPaymentRef").value.trim(),
        photo: tempUploadedProfilePhoto
      };

      if (editId) {
        const idx = state.profiles.findIndex((x) => x.id === editId);
        if (idx !== -1) state.profiles[idx] = { ...state.profiles[idx], ...data };
        persistState(); closeModal("profileFormModal"); showToast(t("profileUpdatedToast"), "success");
      } else {
        const newId = generateNextMemberId(gender);
        state.profiles.unshift({ id: newId, status: "AVAILABLE", isHidden: false, ...data });
        persistState(); closeModal("profileFormModal"); showToast(t("profileSavedToast")(newId), "success");
      }
      renderAll();
    }

