    function exportProfilesCsv() {
      const headers = ["Member ID", "Name", "Category", "Age", "Marital Status", "Height", "Religion", "Caste", "Language", "Education", "Occupation", "Income", "Village/City", "Status", "Hidden", "Registered On", "Valid Until", "Payment Ref", "Mobile", "Parent Phone", "Email", "Full Address"];
      const csvCell = (v) => `"${String(v ?? "").replace(/"/g, '""')}"`;
      const rows = state.profiles.map((p) => [
        p.id, p.name, p.gender, p.age, p.maritalStatus || "", p.height || "", p.religion || "", p.caste || "",
        p.language || "", p.education || "", p.occupation || "", p.income || "", p.village || "", p.status,
        p.isHidden ? "Yes" : "No", p.registeredAt || "", getExpiryDateIso(p.registeredAt), p.paymentRef || "",
        p.mobile || "", p.parentPhone || "", p.email || "", p.fullAddress || ""
      ].map(csvCell).join(","));
      const csv = "\uFEFF" + headers.map(csvCell).join(",") + "\n" + rows.join("\n");
      const blob = new Blob([csv], { type: "text/csv;charset=utf-8;" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url; a.download = `Akshay_Vadhu_Var_Members_${toIsoDate(new Date())}.csv`;
      document.body.appendChild(a); a.click(); document.body.removeChild(a);
      URL.revokeObjectURL(url);
      showToast(t("csvExportedToast"), "success");
    }

