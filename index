  <style>
    :root {
      --bg-ivory: #F8F4EC;
      --maroon: #68283C;
      --gold: #B69A66;
    }

    html {
      scroll-behavior: smooth;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background-color: var(--bg-ivory);
      color: #303030;
      font-family: 'Noto Sans Devanagari', 'Plus Jakarta Sans', system-ui, sans-serif;
      overflow-x: hidden;
    }

    /* Hero Slideshow Crossfade */
    .hero-slide {
      position: absolute;
      inset: 0;
      opacity: 0;
      transition: opacity 0.9s cubic-bezier(0.4, 0, 0.2, 1), transform 6s ease-out;
      transform: scale(1.03);
      pointer-events: none;
    }
    .hero-slide.active {
      opacity: 1;
      transform: scale(1);
      pointer-events: auto;
      z-index: 1;
    }

    /* Editorial Scroll-Flow Transitions (Kanakavalli-Inspired Left/Right Glide) */
    .reveal-left,
    .reveal-right,
    .reveal-up {
      opacity: 0;
      will-change: transform, opacity;
      transition: opacity 0.85s cubic-bezier(0.22, 1, 0.36, 1), transform 0.85s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .reveal-left { transform: translateX(-44px); }
    .reveal-right { transform: translateX(44px); }
    .reveal-up { transform: translateY(28px); }

    .reveal-left.is-visible,
    .reveal-right.is-visible,
    .reveal-up.is-visible {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }

    /* Stagger delays for multi-panel strips */
    .reveal-delay-1 { transition-delay: 0.12s; }
    .reveal-delay-2 { transition-delay: 0.24s; }

    @media (prefers-reduced-motion: reduce) {
      .reveal-left, .reveal-right, .reveal-up {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
      }
    }

    /* Editorial Image Frame Hover Zoom */
    .editorial-photo-frame img {
      transition: transform 0.85s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .editorial-photo-frame:hover img {
      transform: scale(1.045);
    }

    /* Minimal Profile Card with Smooth Hover (PC) / Tap (Mobile) Reveal */
    .profile-card {
      position: relative;
      overflow: hidden;
      border-radius: 1.25rem;
      background: #1f1115;
      aspect-ratio: 3 / 4;
      cursor: pointer;
      transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.35s ease;
      box-shadow: 0 10px 26px -10px rgba(74, 7, 25, 0.22);
      user-select: none;
    }

    .profile-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 18px 36px -12px rgba(104, 40, 60, 0.30);
    }

    .profile-card-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1), filter 0.4s ease;
    }

    .profile-card-base-gradient {
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(28, 10, 16, 0.90) 0%, rgba(28, 10, 16, 0.25) 38%, rgba(28, 10, 16, 0.0) 65%);
      transition: opacity 0.35s ease;
      pointer-events: none;
    }

    .profile-card-resting {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      padding: 1.15rem;
      transition: opacity 0.28s ease, transform 0.32s ease;
    }

    .profile-card-drawer {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 1.1rem;
      background: linear-gradient(to top, rgba(35, 9, 18, 0.96) 0%, rgba(49, 13, 25, 0.92) 72%, rgba(49, 13, 25, 0.72) 100%);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      opacity: 0;
      transform: translateY(22px);
      pointer-events: none;
      transition: opacity 0.34s cubic-bezier(0.22, 1, 0.36, 1), transform 0.34s cubic-bezier(0.22, 1, 0.36, 1);
    }

    @media (hover: hover) and (pointer: fine) {
      .profile-card:hover .profile-card-img {
        transform: scale(1.06);
        filter: brightness(0.78);
      }
      .profile-card:hover .profile-card-resting {
        opacity: 0;
        transform: translateY(10px);
      }
      .profile-card:hover .profile-card-drawer {
        opacity: 1;
        transform: translateY(0);
        pointer-events: auto;
      }
    }

    .profile-card.is-revealed .profile-card-img {
      transform: scale(1.05);
      filter: brightness(0.75);
    }
    .profile-card.is-revealed .profile-card-resting {
      opacity: 0;
      transform: translateY(10px);
    }
    .profile-card.is-revealed .profile-card-drawer {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }

    .fade-in {
      animation: fadeInUp 0.28s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    ::-webkit-scrollbar { width: 7px; height: 7px; }
    ::-webkit-scrollbar-track { background: #F8F4EC; }
    ::-webkit-scrollbar-thumb { background: #dfc4cb; border-radius: 99px; }
    ::-webkit-scrollbar-thumb:hover { background: #68283C; }

    /* Print styling for Rules PDF & Printable Member Biodata */
    @media print {
      body * { visibility: hidden !important; }
      .print-target, .print-target * { visibility: visible !important; }
      .print-target {
        position: fixed !important;
        left: 0; top: 0; width: 100%;
        background: #fff !important;
        color: #111 !important;
        padding: 24px !important;
        box-shadow: none !important;
        border: none !important;
      }
      .no-print { display: none !important; }
      .reveal-left, .reveal-right, .reveal-up { opacity: 1 !important; transform: none !important; }
    }
  </style>
</head>
