      [
        "adminLaunchPackTitle", "adminLaunchPackSub", "btnCopyLaunchMr", "btnCopyLaunchEn",
        "setPricesTitle", "lblSetRegFee", "lblSetValidityMonths", "lblSetMelavaMaleFee", "lblSetMelavaFemaleFee",
        "setStatsTitle", "setStatsSubtitle", "lblSetSinceYear", "lblSetBaseMatches", "lblSetBaseProfiles", "lblSetBaseMeetups",
        "setAboutTitle", "lblSetShowGrandfather", "lblSetShowInstitution", "lblSetGrandfatherBioMr", "lblSetGrandfatherBioEn",
        "lblSetInstDescMr", "lblSetInstDescEn", "lblSetSlideshowFiles", "lblSetBusinessPicsFiles",
        "setCoordTitle", "lblSetCoordNameMr", "lblSetCoordNameEn", "lblSetCoordPhone", "lblSetCoordEmail",
        "lblSetCoordAddress", "lblSetAdminPassword", "lblSetCoordPhoto", "lblSetQrPhoto", "btnSaveSettings"
      ].forEach((id) => { document.getElementById(id).textContent = t(id); });

      const p = state.settings.prices, b = state.settings.baseStats, a = state.settings.about, c = state.settings.coordinator;
      const stats = getComputedStats();

      document.getElementById("setRegFee").value = p.registrationFee;
      document.getElementById("setValidityMonths").value = p.validityMonths;
      document.getElementById("setMelavaMaleFee").value = p.melavaMaleFee;
      document.getElementById("setMelavaFemaleFee").value = p.melavaFemaleFee;

      document.getElementById("setSinceYear").value = state.settings.sinceYear;
      document.getElementById("setBaseMatches").value = b.matchesMade;
      document.getElementById("setBaseProfiles").value = b.membersListed;
      document.getElementById("setBaseMeetups").value = b.meetupsHeld;

      document.getElementById("liveMatchesPreview").textContent = t("livePreviewText")(stats.baseMatches, stats.liveMatches, stats.totalMatches);
      document.getElementById("liveProfilesPreview").textContent = t("livePreviewText")(stats.baseProfiles, stats.liveProfiles, stats.totalProfiles);
      document.getElementById("liveMeetupsPreview").textContent = t("livePreviewText")(stats.baseMeetups, stats.liveMeetups, stats.totalMeetups);

      document.getElementById("setShowGrandfather").checked = Boolean(a.showGrandfather);
      document.getElementById("setShowInstitution").checked = Boolean(a.showInstitution);
      document.getElementById("setGrandfatherBioMr").value = a.grandfatherBioMr || "";
      document.getElementById("setGrandfatherBioEn").value = a.grandfatherBioEn || "";
      document.getElementById("setInstDescMr").value = a.instDescMr || "";
      document.getElementById("setInstDescEn").value = a.instDescEn || "";
      document.getElementById("setSlideshowFiles").value = (state.settings.slideshowFiles || []).join(", ");
      document.getElementById("setBusinessPicsFiles").value = (state.settings.businessPicsFiles || []).join(", ");

      document.getElementById("setCoordNameMr").value = c.nameMr;
      document.getElementById("setCoordNameEn").value = c.nameEn;
      document.getElementById("setCoordPhone").value = c.phone;
      document.getElementById("setCoordEmail").value = c.email || "info@akshayvadhuvar.in";
      document.getElementById("setCoordAddress").value = c.address;
      document.getElementById("setAdminPassword").value = "";
      document.getElementById("setAdminPassword").placeholder = t("adminPassKeepPh");
    }

    function handleAssetUpload(e, kind) {
      const file = e.target.files?.[0];
      if (!file) return;
      compressImageFile(file, 520, 0.8, (dataUrl) => {
        if (kind === "coordinatorPhoto") state.settings.coordinator.photoData = dataUrl;
        if (kind === "qrCodePhoto") state.settings.coordinator.qrData = dataUrl;
        persistState(); showToast(t("settingsSavedToast"), "success"); renderLandingView();
      });
    }

    function saveGeneralSettings(e) {
      e.preventDefault();
      state.settings.prices.registrationFee = Math.max(0, Number(document.getElementById("setRegFee").value) || 0);
      state.settings.prices.validityMonths = Math.max(1, Number(document.getElementById("setValidityMonths").value) || 6);
      state.settings.prices.melavaMaleFee = Math.max(0, Number(document.getElementById("setMelavaMaleFee").value) || 0);
      state.settings.prices.melavaFemaleFee = Math.max(0, Number(document.getElementById("setMelavaFemaleFee").value) || 0);

      state.settings.sinceYear = document.getElementById("setSinceYear").value.trim() || "2000";
      state.settings.baseStats.matchesMade = Math.max(0, Number(document.getElementById("setBaseMatches").value) || 0);
      state.settings.baseStats.membersListed = Math.max(0, Number(document.getElementById("setBaseProfiles").value) || 0);
      state.settings.baseStats.meetupsHeld = Math.max(0, Number(document.getElementById("setBaseMeetups").value) || 0);

      state.settings.about.showGrandfather = document.getElementById("setShowGrandfather").checked;
      state.settings.about.showInstitution = document.getElementById("setShowInstitution").checked;
      state.settings.about.grandfatherBioMr = fixDeoleSpelling(document.getElementById("setGrandfatherBioMr").value.trim());
      state.settings.about.grandfatherBioEn = document.getElementById("setGrandfatherBioEn").value.trim();
      state.settings.about.instDescMr = fixDeoleSpelling(document.getElementById("setInstDescMr").value.trim());
      state.settings.about.instDescEn = document.getElementById("setInstDescEn").value.trim();

      const slideRaw = document.getElementById("setSlideshowFiles").value.split(",").map((s) => s.trim()).filter(Boolean);
      if (slideRaw.length) state.settings.slideshowFiles = slideRaw;

      const bizRaw = document.getElementById("setBusinessPicsFiles").value.split(",").map((s) => s.trim()).filter(Boolean);
      if (bizRaw.length) state.settings.businessPicsFiles = bizRaw;

      state.settings.coordinator.nameMr = fixDeoleSpelling(document.getElementById("setCoordNameMr").value.trim());
      state.settings.coordinator.nameEn = document.getElementById("setCoordNameEn").value.trim();
      state.settings.coordinator.phone = document.getElementById("setCoordPhone").value.trim();
      state.settings.coordinator.email = document.getElementById("setCoordEmail").value.trim();
      state.settings.coordinator.address = document.getElementById("setCoordAddress").value.trim();

      const newPass = document.getElementById("setAdminPassword").value.trim();
      if (newPass) state.settings.adminPassword = newPass;

      persistState(); showToast(t("settingsSavedToast"), "success"); renderHeroSlideshow(true); renderAll();
    }

    // =========================================================================
    // 13. RULES, PRIVACY & SAFETY MODAL
    // =========================================================================
    function getRulesLines() {
      const p = state.settings.prices, m = state.melava, c = state.settings.coordinator;
      if (currentLang === "mr") {
        return [
          `१. सदस्यत्व व शुल्क: पूर्ण सदस्यत्व शुल्क ₹${p.registrationFee} (${p.validityMonths} महिने वैधता) आहे. प्राथमिक चौकशी मोफत आहे. शुल्क भरल्याने विवाह जुळण्याची हमी दिली जात नाही.`,
          `२. संमती व पात्रता: केवळ भारतीय कायद्यानुसार विवाहयोग्य वयाच्या प्रौढ व्यक्तींसाठीच (वधू १८+, वर २१+) नोंदणी खुली आहे. पालक नोंदणी करत असल्यास संबंधित उमेदवाराची संमती आवश्यक आहे.`,
          `३. गोपनीयता व प्रोफाइल नियंत्रण: मोबाईल नंबर, ईमेल आणि संपूर्ण पत्ता सार्वजनिक केला जात नाही. दोन्ही कुटुंबांच्या संमतीनंतरच संचालक संपर्क माहिती देतात. सदस्य कधीही आपले प्रोफाइल लपवू शकतात किंवा काढून टाकण्याची विनंती करू शकतात.`,
          `४. सर्व समाजांसाठी खुले: जात, धर्म, उत्पन्न किंवा भाषा बंधनकारक नाही; सर्व समाज, धर्म व पुनर्विवाह उमेदवारांचे स्वागत आहे.`,
          `५. परिचय मेळावा नियम: वधू प्रवेश ${p.melavaFemaleFee === 0 ? "मोफत" : "₹" + p.melavaFemaleFee}, वर प्रवेश ${p.melavaMaleFee === 0 ? "मोफत" : "₹" + p.melavaMaleFee}. मेळाव्यात फक्त वधू-वरांनाच प्रवेश आहे (कुटुंबीयांना आत प्रवेश नाही). किमान ${m.minTenureMonths} महिने नोंदणी आवश्यक.`,
          `६. सुरक्षा व पडताळणी: प्रत्येक प्रोफाइल संचालकांकडून तपासले जाते; मात्र ते संपूर्ण शासकीय ओळख पडताळणी मानले जाऊ नये. कधीही OTP किंवा UPI PIN शेअर करू नका आणि कोणत्याही विवाह निर्णयापूर्वी स्वतंत्र खात्री करून घ्या.`,
          `७. संपर्क व मदत: ${c.address} | फोन / WhatsApp: ${c.phone} | ई-मेल: ${c.email || "info@akshayvadhuvar.in"}`
        ];
      }
      return [
        `1. Membership & Outcome Disclosure: Full membership is ₹${p.registrationFee} for ${p.validityMonths} months validity. Initial enquiry is free. Payment provides opportunities for introduction and guidance—it does not guarantee a match or marriage.`,
        `2. Consent & Legal Eligibility: Registration is open only to adults of legally marriageable age (18+ for Brides, 21+ for Grooms). Parents registering on behalf of an adult candidate must have the candidate's authorisation.`,
        `3. Privacy & Member Controls: Phone numbers, email addresses, and home addresses are never displayed publicly and are shared only by the coordinator with mutual consent. Members can hide their profile or request deletion anytime.`,
        `4. Open to All Communities: Religion, caste, income, and language are optional—eligible candidates from all communities, including divorced, widowed, and remarriage profiles, are welcome.`,
        `5. Parichay Melava Rules: Entry fee — Brides: ${p.melavaFemaleFee === 0 ? "Free" : "₹" + p.melavaFemaleFee}, Grooms: ${p.melavaMaleFee === 0 ? "Free" : "₹" + p.melavaMaleFee}. Only registered brides and grooms are permitted inside the hall (minimum ${m.minTenureMonths} months registration tenure).`,
        `6. Safety & Independent Verification: Profiles are reviewed by staff before listing, which does not constitute full government identity verification. Never share OTPs or UPI PINs, and always verify details independently before finalizing any match.`,
        `7. Official Contact: ${c.address} | Phone / WhatsApp: ${c.phone} | Email: ${c.email || "info@akshayvadhuvar.in"}`
      ];
    }

    function openRulesModal() {
      document.getElementById("rulesModalHeader").textContent = t("rulesModalHeader");
      document.getElementById("btnDownloadRulesTxt").textContent = t("btnDownloadRulesTxt");
      document.getElementById("btnPrintRulesPdf").textContent = t("btnPrintRulesPdf");
      document.getElementById("rulesPrintArea").innerHTML = `
        <div class="border-b border-cream-200 pb-3">
          <h4 class="text-base font-extrabold text-brand-900">${escapeHtml(t("brandName"))} (${escapeHtml(t("sincePrefix"))} ${escapeHtml(state.settings.sinceYear)})</h4>
          <p class="text-xs text-brand-600 font-semibold">${escapeHtml(t("slogan"))}</p>
        </div>
        <ul class="space-y-2.5 pt-1">${getRulesLines().map((r) => `<li class="bg-cream-50 p-3 rounded-xl border border-cream-200">${escapeHtml(r)}</li>`).join("")}</ul>
      `;
      document.getElementById("rulesModal").classList.remove("hidden");
    }

    function downloadRulesText() {
      const content = `${t("brandName")} (${t("sincePrefix")} ${state.settings.sinceYear})\n${t("slogan")}\n\n` + getRulesLines().join("\n\n");
      const blob = new Blob([content], { type: "text/plain;charset=utf-8" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url; a.download = currentLang === "mr" ? "Akshay_Vadhu_Var_Kendra_Policy_Marathi.txt" : "Akshay_Vadhu_Var_Kendra_Policy_English.txt";
      document.body.appendChild(a); a.click(); document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }

    document.addEventListener("keydown", (e) => {
      if (e.ctrlKey && e.shiftKey && e.key.toLowerCase() === "a") { e.preventDefault(); openAdminPasswordModal(); }
      if (e.key === "Escape") ["memberLoginModal", "adminPasswordModal", "profileDetailModal", "profileFormModal", "shareStoryModal", "rulesModal", "confirmDialogModal"].forEach(closeModal);
    });

    // Boot
    loadInitialState();
  </script>
</body>
