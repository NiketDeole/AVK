        return `
          <div class="${tripCols[i]} rounded-2xl overflow-hidden border border-gold-400/50 shadow-card bg-white">
            ${buildBusinessPhotoPanelHtml(fName, caps[i], grads[i % grads.length], "min-h-[240px] sm:min-h-[300px]")}
