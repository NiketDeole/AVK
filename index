      const fieldLabels = I18N[currentLang].fields;
      const existingReq = state.matchRequests.find((r) => r.fromId === me.id && r.toId === p.id);
      const isSaved = getMySavedIds().includes(p.id);
      const photoSrc = p.photo || getAvatarFallbackSvg(p.gender);

      const detailItems = VISIBILITY_FIELD_KEYS.filter((k) => vis[k] && p[k]).map((k) => {
        const val = k === "age" ? `${p[k]} ${t("yearsUnit")}` : p[k];
        return `<div class="bg-cream-50 rounded-xl p-3 border border-cream-200"><div class="text-[11px] font-bold text-stone-500">${escapeHtml(fieldLabels[k])}</div><div class="text-sm font-bold text-brand-950 mt-0.5 break-words">${escapeHtml(val)}</div></div>`;
      }).join("");

      let actionBlock = "";
      if (existingReq) actionBlock = `<div class="bg-emerald-50 border border-emerald-200 rounded-xl p-3.5 text-xs sm:text-sm font-bold text-emerald-800 text-center">${escapeHtml(t("alreadyInterestedNote"))}</div>`;
      else if (p.status !== "AVAILABLE") actionBlock = `<div class="bg-amber-50 border border-amber-200 rounded-xl p-3.5 text-xs sm:text-sm font-bold text-amber-900 text-center">${escapeHtml(t("cannotInterestBooked"))}</div>`;
      else {
        actionBlock = `
          <div class="space-y-2">
            <button type="button" onclick="expressInterest('${escapeHtml(p.id)}')" class="w-full py-3 px-4 rounded-xl bg-brand-800 hover:bg-brand-900 text-white font-extrabold text-sm shadow-sm transition-colors">${escapeHtml(t("expressInterestBtn"))}</button>
            <p class="text-[11px] text-stone-500 text-center">${escapeHtml(t("expressInterestConfirmNote"))}</p>
          </div>`;
      }

      document.getElementById("profileDetailContent").innerHTML = `
        <div id="biodataPrintSection">
          <div class="relative">
            <div class="h-64 sm:h-72 bg-stone-900 overflow-hidden"><img src="${photoSrc}" alt="${escapeHtml(p.name)}" class="w-full h-full object-cover" /></div>
            <button type="button" onclick="closeModal('profileDetailModal')" class="no-print absolute top-3 right-3 w-9 h-9 rounded-full bg-black/60 hover:bg-black/80 text-white font-bold flex items-center justify-center">✕</button>
            <div class="absolute bottom-3 left-3">${getStatusBadgeHtml(p.status)}</div>
          </div>
          <div class="p-5 sm:p-6 space-y-4">
            <div class="flex items-start justify-between gap-2">
              <div>
                <h3 class="text-xl font-extrabold text-brand-900">${escapeHtml(p.name)}</h3>
                <p class="text-xs font-bold text-brand-600 mt-0.5">${escapeHtml(p.id)} • ${escapeHtml(t("brandName"))}</p>
              </div>
              <div class="flex items-center gap-1.5 no-print">
                <button type="button" onclick="toggleSaveProfile('${escapeHtml(p.id)}')" class="px-3 py-1.5 rounded-lg text-xs font-bold ${isSaved ? "bg-amber-200 text-amber-950" : "bg-cream-200 text-brand-900 hover:bg-cream-300"}">${escapeHtml(isSaved ? t("savedProfileBtn") : t("saveProfileBtn"))}</button>
                <button type="button" onclick="printElement('biodataPrintSection')" class="px-3 py-1.5 rounded-lg bg-stone-100 hover:bg-stone-200 text-stone-800 text-xs font-bold">${escapeHtml(t("printBiodataBtn"))}</button>
              </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">${detailItems}</div>
            <div class="bg-rose-50/70 border border-rose-200 rounded-xl p-3 text-xs text-brand-900 flex items-start gap-2">
              <svg class="w-4 h-4 text-brand-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
              <span>${escapeHtml(t("privateFieldsProtectedNote"))}</span>
            </div>
            <div class="no-print space-y-3">
              ${actionBlock}
              <div class="text-center pt-1">
                <button type="button" onclick="reportProfileConcern('${escapeHtml(p.id)}')" class="text-[11px] font-semibold text-stone-400 hover:text-red-700 hover:underline">${escapeHtml(t("reportProfileBtn"))}</button>
              </div>
            </div>
          </div>
        </div>`;
      document.getElementById("profileDetailModal").classList.remove("hidden");
    }

    function expressInterest(targetId) {
      const me = state.profiles.find((p) => p.id === loggedInMemberId);
      const target = state.profiles.find((p) => p.id === targetId);
      if (!me || !target) return;
      if (state.matchRequests.some((r) => r.fromId === me.id && r.toId === target.id)) return;
      state.matchRequests.unshift({ id: "REQ-" + Date.now(), fromId: me.id, toId: target.id, status: "PENDING", createdAt: toIsoDate(new Date()) });
      persistState();
      showToast(t("interestSuccessToast"), "success");
      closeModal("profileDetailModal");
      renderMemberPortal();
    }

    function renderMyInterests(me) {
      document.getElementById("myInterestsTitle").textContent = t("myInterestsTitle");
      const listEl = document.getElementById("myInterestsList");
      const mine = state.matchRequests.filter((r) => r.fromId === me.id);
      if (!mine.length) { listEl.innerHTML = `<p class="text-sm text-stone-500 py-4 text-center">${escapeHtml(t("noInterestsYet"))}</p>`; return; }
      listEl.innerHTML = mine.map((r) => {
        const target = state.profiles.find((p) => p.id === r.toId);
        const name = target ? target.name : r.toId;
        const badgeCls = r.status === "INTRO_ARRANGED" ? "bg-blue-100 text-blue-800"
          : r.status === "APPROVED" ? "bg-emerald-100 text-emerald-800"
          : r.status === "REJECTED" ? "bg-red-100 text-red-800" : "bg-amber-100 text-amber-800";
        const statusTxt = r.status === "INTRO_ARRANGED" ? t("interestIntroArrangedBadge")
