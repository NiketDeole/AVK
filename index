              <a href="${ch.ctaHref}" class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-brand-800 border-b border-brand-800/50 hover:border-brand-800 pb-0.5 transition-colors">${escapeHtml(ch.ctaText)}</a>
            </div>
          </div>`;

        const imgCol = `
          <div class="lg:col-span-6 ${imgOnLeft ? "reveal-left" : "reveal-right"}">
            ${buildBusinessPhotoPanelHtml(picFile, ch.imgCaption, grads[idx % grads.length], "min-h-[280px] sm:min-h-[380px]")}
