    function submitBasicEnquiry(e) {
      e.preventDefault();
      const profileFor = document.getElementById("enqProfileFor").value;
      const dob = document.getElementById("enqDob").value;
      const age = getAgeFromDob(dob);
      const errEl = document.getElementById("enqAgeError");
      const minAge = profileFor === "groom" ? 21 : 18;
      if (!dob || age < minAge) {
        errEl.textContent = profileFor === "groom" ? t("enqAgeErrorGroom") : t("enqAgeErrorBride");
        errEl.classList.remove("hidden");
        return;
      }
      errEl.classList.add("hidden");

      state.enquiries.unshift({
        id: "ENQ-" + Date.now(),
        profileFor,
        regBy: document.getElementById("enqRegBy").value,
        name: document.getElementById("enqName").value.trim(),
        dob,
        age,
        city: document.getElementById("enqCity").value.trim(),
        mobile: document.getElementById("enqMobile").value.trim(),
        maritalStatus: document.getElementById("enqMaritalStatus").value,
        consentAt: new Date().toISOString(),
        createdAt: toIsoDate(new Date())
      });
      persistState();
      document.getElementById("basicEnquiryForm").reset();
      showToast(t("enqSubmittedToast"), "success");
    }

    // =========================================================================
    // 10. MEMBER LOGIN, PRIVACY CONTROLS, SAVED PROFILES, REPORT & PORTAL
    // =========================================================================
    function handleMemberLogin(e) {
      e.preventDefault();
      const input = document.getElementById("memberIdInput");
      const errEl = document.getElementById("loginErrorMsg");
      const entered = input.value.trim().toUpperCase();
      if (!entered) { errEl.textContent = t("loginErrorEmpty"); errEl.classList.remove("hidden"); return; }
      const member = state.profiles.find((p) => p.id.toUpperCase() === entered);
      if (!member) { errEl.textContent = t("loginErrorNotFound"); errEl.classList.remove("hidden"); return; }
      if (isProfileExpired(member)) { errEl.textContent = t("loginErrorExpired"); errEl.classList.remove("hidden"); return; }
      errEl.classList.add("hidden");
      loggedInMemberId = member.id;
      currentMemberTab = "profiles";
      input.value = "";
      closeModal("memberLoginModal");
      renderAll();
      window.scrollTo({ top: 0, behavior: "smooth" });
    }

    function logoutMember() { loggedInMemberId = null; renderAll(); window.scrollTo({ top: 0, behavior: "smooth" }); }
    function switchMemberTab(tab) { currentMemberTab = tab; renderMemberPortal(); }

    function toggleMyProfileHidden() {
      const me = state.profiles.find((p) => p.id === loggedInMemberId);
      if (!me) return;
      me.isHidden = !me.isHidden;
      persistState();
      showToast(me.isHidden ? t("profileHiddenToast") : t("profileUnhiddenToast"), "info");
      renderMemberPortal();
    }

    function requestMyProfileDeletion() {
      const me = state.profiles.find((p) => p.id === loggedInMemberId);
      if (!me) return;
      if (!state.deletionRequests.some((d) => d.memberId === me.id)) {
        state.deletionRequests.unshift({
          id: "DEL-" + Date.now(),
          memberId: me.id,
          memberName: me.name,
          createdAt: toIsoDate(new Date())
        });
        persistState();
      }
      showToast(t("deleteReqSentToast"), "info");
    }

    function getMySavedIds() {
      if (!loggedInMemberId) return [];
      const arr = state.savedMap[loggedInMemberId];
      return Array.isArray(arr) ? arr : [];
    }

    function toggleSaveProfile(targetId, event) {
      if (event) event.stopPropagation();
      if (!loggedInMemberId) return;
      const cur = getMySavedIds();
      if (cur.includes(targetId)) state.savedMap[loggedInMemberId] = cur.filter((x) => x !== targetId);
      else state.savedMap[loggedInMemberId] = [targetId, ...cur];
      persistState();
      renderMemberPortal();
      if (!document.getElementById("profileDetailModal").classList.contains("hidden")) {
        openProfileDetailModal(targetId);
      }
    }

    function reportProfileConcern(targetId) {
      if (!loggedInMemberId) return;
      state.reports.unshift({
        id: "RPT-" + Date.now(),
        reporterId: loggedInMemberId,
        targetId,
        createdAt: toIsoDate(new Date())
      });
      persistState();
      showToast(t("reportedSuccessToast"), "info");
    }

    function populateFilterSelect(selectId, allLabel, values) {
      const sel = document.getElementById(selectId);
      const prev = sel.value || "ALL";
      const unique = [...new Set(values.filter(Boolean).map((v) => String(v).trim()))].sort((a, b) => a.localeCompare(b));
      sel.innerHTML = `<option value="ALL">${escapeHtml(allLabel)}</option>` + unique.map((v) => `<option value="${escapeHtml(v)}">${escapeHtml(v)}</option>`).join("");
      sel.value = unique.includes(prev) ? prev : "ALL";
    }

    function resetMemberFilters() {
      document.getElementById("memberSearchInput").value = "";
      ["filterReligion", "filterCaste", "filterHeight", "filterOccupation", "filterLanguage", "memberStatusFilter"].forEach((id) => { document.getElementById(id).value = "ALL"; });
      document.getElementById("memberSortBy").value = "DEFAULT";
      renderMemberProfiles();
    }

    function renderMemberPortal() {
      const me = state.profiles.find((p) => p.id === loggedInMemberId);
      if (!me) return;

      const targetPlural = me.gender === "groom" ? t("roleBridesPlural") : t("roleGroomsPlural");
      document.getElementById("memberPortalGreeting").textContent = t("welcomeMember")(me.name);
      document.getElementById("memberPortalIdPill").textContent = `${me.id} • ${me.gender === "groom" ? t("roleGroom") : t("roleBride")}`;
      const hiddenBadge = document.getElementById("memberHiddenBadge");
      hiddenBadge.textContent = t("memberHiddenBadge");
      hiddenBadge.classList.toggle("hidden", !me.isHidden);
      document.getElementById("memberPortalSubinfo").textContent = t("memberSubinfo")(targetPlural, formatDisplayDate(getExpiryDateIso(me.registeredAt)), getMonthsBetween(me.registeredAt));
      document.getElementById("memberPrivacyBarNote").textContent = t("memberPrivacyBarNote");
      document.getElementById("btnToggleHideProfile").textContent = me.isHidden ? t("btnUnhideProfile") : t("btnHideProfile");
      document.getElementById("btnRequestDeleteProfile").textContent = t("btnRequestDeleteProfile");

      const savedCount = getMySavedIds().length;
      const tabs = [
        { id: "profiles", btn: "memberTabProfilesBtn", label: t("tabProfiles") },
        { id: "saved", btn: "memberTabSavedBtn", label: `${t("tabSaved")}${savedCount ? ` (${savedCount})` : ""}` },
        { id: "melava", btn: "memberTabMelavaBtn", label: t("tabMelava") },
        { id: "interests", btn: "memberTabInterestsBtn", label: t("tabInterests") }
      ];
      tabs.forEach((tb) => {
        const b = document.getElementById(tb.btn);
        b.textContent = tb.label;
        b.className = currentMemberTab === tb.id
          ? "px-3 py-2 rounded-lg text-xs sm:text-sm font-extrabold bg-brand-800 text-white shadow-xs transition-all"
          : "px-3 py-2 rounded-lg text-xs sm:text-sm font-bold text-stone-700 hover:text-brand-800 transition-all";
        document.getElementById(`memberSubView-${tb.id}`).classList.toggle("hidden", currentMemberTab !== tb.id);
      });

      const targetGender = me.gender === "groom" ? "bride" : "groom";
      const pool = state.profiles.filter((p) => p.gender === targetGender && !isProfileExpired(p) && !p.isHidden);
      const vis = state.settings.visibility;

      populateFilterSelect("filterReligion", t("filterAllReligion"), vis.religion ? pool.map((p) => p.religion) : []);
      populateFilterSelect("filterCaste", t("filterAllCaste"), vis.caste ? pool.map((p) => p.caste) : []);
      populateFilterSelect("filterOccupation", t("filterAllOccupation"), vis.occupation ? pool.map((p) => p.occupation) : []);
      populateFilterSelect("filterLanguage", t("filterAllLanguage"), vis.language ? pool.map((p) => p.language) : []);

      const hf = document.getElementById("filterHeight");
      const prevHf = hf.value || "ALL";
      hf.innerHTML = `<option value="ALL">${escapeHtml(t("filterAllHeight"))}</option><option value="60">${escapeHtml(t("filterHeightMin")("5'0\""))}</option><option value="63">${escapeHtml(t("filterHeightMin")("5'3\""))}</option><option value="66">${escapeHtml(t("filterHeightMin")("5'6\""))}</option><option value="69">${escapeHtml(t("filterHeightMin")("5'9\""))}</option><option value="72">${escapeHtml(t("filterHeightMin")("6'0\""))}</option>`;
      hf.value = prevHf;

      const sf = document.getElementById("memberStatusFilter");
      const prevSf = sf.value || "ALL";
      sf.innerHTML = `<option value="ALL">${escapeHtml(t("filterAllStatus"))}</option><option value="AVAILABLE">${escapeHtml(t("filterAvailable"))}</option><option value="BOOKED">${escapeHtml(t("filterBooked"))}</option><option value="CONFIRMED">${escapeHtml(t("filterConfirmed"))}</option>`;
      sf.value = prevSf;

      const sortSel = document.getElementById("memberSortBy");
      const prevSort = sortSel.value || "DEFAULT";
      sortSel.innerHTML = `<option value="DEFAULT">${escapeHtml(t("sortDefault"))}</option><option value="AGE_ASC">${escapeHtml(t("sortAgeAsc"))}</option><option value="AGE_DESC">${escapeHtml(t("sortAgeDesc"))}</option><option value="HEIGHT_DESC">${escapeHtml(t("sortHeightDesc"))}</option><option value="HEIGHT_ASC">${escapeHtml(t("sortHeightAsc"))}</option><option value="CASTE">${escapeHtml(t("sortCaste"))}</option><option value="OCCUPATION">${escapeHtml(t("sortOccupation"))}</option><option value="RELIGION">${escapeHtml(t("sortReligion"))}</option><option value="LANGUAGE">${escapeHtml(t("sortLanguage"))}</option><option value="NAME">${escapeHtml(t("sortName"))}</option>`;
      sortSel.value = prevSort;

      document.getElementById("memberSearchInput").placeholder = t("searchPlaceholder");
      document.getElementById("cardInteractionHint").textContent = t("cardInteractionHint");
      document.getElementById("btnResetFilters").textContent = t("btnResetFilters");

      if (currentMemberTab === "profiles") renderMemberProfiles();
      if (currentMemberTab === "saved") renderSavedProfiles(me);
      if (currentMemberTab === "melava") document.getElementById("memberMelavaContainer").innerHTML = buildMelavaBoardHtml(true, me);
      if (currentMemberTab === "interests") renderMyInterests(me);
    }

    function getStatusBadgeHtml(status) {
      if (status === "CONFIRMED") return `<span class="px-2.5 py-0.5 rounded-full text-[11px] font-extrabold bg-emerald-600 text-white shadow-xs">${escapeHtml(t("statusConfirmed"))}</span>`;
      if (status === "BOOKED") return `<span class="px-2.5 py-0.5 rounded-full text-[11px] font-extrabold bg-amber-500 text-white shadow-xs">${escapeHtml(t("statusBooked"))}</span>`;
      return `<span class="px-2.5 py-0.5 rounded-full text-[11px] font-extrabold bg-white/90 text-emerald-800 shadow-xs">${escapeHtml(t("statusAvailable"))}</span>`;
    }

    function buildProfileCardHtml(p, me) {
      const vis = state.settings.visibility;
      const fieldLabels = I18N[currentLang].fields;
      const photoSrc = p.photo || getAvatarFallbackSvg(p.gender);
      const existingReq = state.matchRequests.find((r) => r.fromId === me.id && r.toId === p.id);
      const isSaved = getMySavedIds().includes(p.id);

      const publicRows = [];
      ["age", "height", "religion", "caste", "language", "occupation", "education", "village"].forEach((key) => {
        if (vis[key] && p[key]) {
          const val = key === "age" ? `${p[key]} ${t("yearsUnit")}` : p[key];
          publicRows.push(`<div class="flex items-baseline justify-between gap-2 text-xs border-b border-white/10 pb-1"><span class="text-rose-200/80 shrink-0">${escapeHtml(fieldLabels[key])}</span><span class="text-white font-semibold text-right truncate">${escapeHtml(val)}</span></div>`);
        }
      });

      let reqPill = "";
      if (existingReq) {
        const pillText = existingReq.status === "INTRO_ARRANGED" ? t("interestIntroArrangedBadge")
          : existingReq.status === "APPROVED" ? t("interestApprovedBadge")
          : existingReq.status === "REJECTED" ? t("interestRejectedBadge") : t("interestSentBadge");
        reqPill = `<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-brand-600 text-white">${escapeHtml(pillText)}</span>`;
      }

      return `
        <div class="profile-card" onclick="toggleCardReveal(this, event)">
          <img src="${photoSrc}" alt="${escapeHtml(p.name)}" class="profile-card-img" loading="lazy" />
          <div class="profile-card-base-gradient"></div>
          <div class="absolute top-3 left-3 right-3 flex items-center justify-between gap-2 z-10 pointer-events-none">
            ${p.status !== "AVAILABLE" ? getStatusBadgeHtml(p.status) : "<span></span>"}
            ${reqPill}
          </div>
          <div class="profile-card-resting z-10">
            <h3 class="text-white text-base sm:text-lg font-extrabold leading-snug drop-shadow-xs truncate">${escapeHtml(p.name)}</h3>
          </div>
          <div class="profile-card-drawer z-20">
            <div class="mb-2 flex items-start justify-between gap-2">
              <div class="min-w-0">
                <h3 class="text-white text-base font-extrabold leading-tight truncate">${escapeHtml(p.name)}</h3>
                <span class="text-[11px] font-semibold text-amber-300">${escapeHtml(p.id)}</span>
              </div>
              <button type="button" onclick="toggleSaveProfile('${escapeHtml(p.id)}', event)" class="px-2 py-1 rounded-lg text-[11px] font-bold shrink-0 ${isSaved ? "bg-amber-400 text-brand-950" : "bg-white/15 text-white hover:bg-white/25"}">${escapeHtml(isSaved ? t("savedProfileBtn") : t("saveProfileBtn"))}</button>
            </div>
            <div class="space-y-1 mb-3 max-h-44 overflow-y-auto pr-0.5">${publicRows.slice(0, 6).join("")}</div>
            <button type="button" onclick="openProfileDetailModal('${escapeHtml(p.id)}', event)" class="w-full py-2.5 px-3 rounded-xl bg-brand-600 hover:bg-brand-500 active:scale-[0.98] text-white text-xs font-extrabold shadow-md transition-all">${escapeHtml(t("viewFullProfileBtn"))}</button>
          </div>
        </div>`;
    }

    function renderMemberProfiles() {
      const me = state.profiles.find((p) => p.id === loggedInMemberId);
      if (!me) return;
      const targetGender = me.gender === "groom" ? "bride" : "groom";
      const q = (document.getElementById("memberSearchInput").value || "").trim().toLowerCase();
      const relFilter = document.getElementById("filterReligion").value || "ALL";
      const casteFilter = document.getElementById("filterCaste").value || "ALL";
      const heightMinIn = document.getElementById("filterHeight").value || "ALL";
      const occFilter = document.getElementById("filterOccupation").value || "ALL";
      const langFilter = document.getElementById("filterLanguage").value || "ALL";
      const statusFilter = document.getElementById("memberStatusFilter").value || "ALL";
      const sortBy = document.getElementById("memberSortBy").value || "DEFAULT";
      const vis = state.settings.visibility;

      let filtered = state.profiles.filter((p) => {
        if (p.gender !== targetGender || isProfileExpired(p) || p.isHidden) return false;
        if (statusFilter !== "ALL" && p.status !== statusFilter) return false;
        if (relFilter !== "ALL" && (!vis.religion || (p.religion || "").trim() !== relFilter)) return false;
        if (casteFilter !== "ALL" && (!vis.caste || (p.caste || "").trim() !== casteFilter)) return false;
        if (occFilter !== "ALL" && (!vis.occupation || (p.occupation || "").trim() !== occFilter)) return false;
        if (langFilter !== "ALL" && (!vis.language || (p.language || "").trim() !== langFilter)) return false;
        if (heightMinIn !== "ALL") {
          if (!vis.height) return false;
          const inches = parseHeightToInches(p.height);
          if (!inches || inches < Number(heightMinIn)) return false;
        }
        if (!q) return true;
        const searchable = [p.name, p.id];
        VISIBILITY_FIELD_KEYS.forEach((k) => { if (vis[k] && p[k]) searchable.push(String(p[k])); });
        return searchable.join(" ").toLowerCase().includes(q);
      });

      const strCmp = (a, b) => (a || "zzz").localeCompare(b || "zzz");
      if (sortBy === "AGE_ASC") filtered.sort((a, b) => (a.age || 99) - (b.age || 99));
      else if (sortBy === "AGE_DESC") filtered.sort((a, b) => (b.age || 0) - (a.age || 0));
      else if (sortBy === "HEIGHT_DESC") filtered.sort((a, b) => parseHeightToInches(b.height) - parseHeightToInches(a.height));
      else if (sortBy === "HEIGHT_ASC") filtered.sort((a, b) => (parseHeightToInches(a.height) || 999) - (parseHeightToInches(b.height) || 999));
      else if (sortBy === "CASTE") filtered.sort((a, b) => strCmp(vis.caste ? a.caste : "", vis.caste ? b.caste : ""));
      else if (sortBy === "OCCUPATION") filtered.sort((a, b) => strCmp(vis.occupation ? a.occupation : "", vis.occupation ? b.occupation : ""));
      else if (sortBy === "RELIGION") filtered.sort((a, b) => strCmp(vis.religion ? a.religion : "", vis.religion ? b.religion : ""));
      else if (sortBy === "LANGUAGE") filtered.sort((a, b) => strCmp(vis.language ? a.language : "", vis.language ? b.language : ""));
      else if (sortBy === "NAME") filtered.sort((a, b) => strCmp(a.name, b.name));

      document.getElementById("memberProfileCountBadge").textContent = t("profilesFound")(filtered.length);
      const grid = document.getElementById("memberProfilesGrid");
      if (!filtered.length) {
        grid.innerHTML = `<div class="col-span-full bg-white rounded-2xl border border-cream-300 p-10 text-center text-stone-500 text-sm">${escapeHtml(t("noProfilesYet"))}</div>`;
        return;
      }
      grid.innerHTML = filtered.map((p) => buildProfileCardHtml(p, me)).join("");
    }

    function renderSavedProfiles(me) {
      document.getElementById("savedProfilesTitle").textContent = t("savedProfilesTitle");
      const savedIds = getMySavedIds();
      const targetGender = me.gender === "groom" ? "bride" : "groom";
      const list = state.profiles.filter((p) => savedIds.includes(p.id) && p.gender === targetGender && !isProfileExpired(p) && !p.isHidden);
      const grid = document.getElementById("savedProfilesGrid");
      if (!list.length) {
        grid.innerHTML = `<div class="col-span-full text-center text-stone-500 text-sm py-6">${escapeHtml(t("noSavedYet"))}</div>`;
        return;
      }
      grid.innerHTML = list.map((p) => buildProfileCardHtml(p, me)).join("");
    }

    function toggleCardReveal(cardEl, event) {
      if (event && event.target.closest("button")) return;
      const alreadyOpen = cardEl.classList.contains("is-revealed");
      document.querySelectorAll(".profile-card.is-revealed").forEach((c) => c.classList.remove("is-revealed"));
      if (!alreadyOpen) cardEl.classList.add("is-revealed");
    }

    function openProfileDetailModal(profileId, event) {
