    function submitMelavaRegistration(e) {
      e.preventDefault();
      const me = state.profiles.find((p) => p.id === loggedInMemberId);
      if (!me) return;
      const slotId = document.getElementById("melavaSlotSelect").value;
      const slot = state.melava.slots.find((s) => s.id === slotId);
      const payRefEl = document.getElementById("melavaPayRef");
      const fee = me.gender === "bride" ? Number(state.settings.prices.melavaFemaleFee) : Number(state.settings.prices.melavaMaleFee);

      state.melavaRegistrations.unshift({
        id: "MREG-" + Date.now(), memberId: me.id, memberName: me.name, gender: me.gender, age: me.age,
        mobile: me.mobile || "", slotId, slotLabel: slot ? `${slot.time} (${slot.minAge}-${slot.maxAge})` : slotId,
        feePaid: fee, paymentRef: payRefEl ? payRefEl.value.trim() : "FREE",
        melavaDateIso: state.melava.dateIso, submittedAt: toIsoDate(new Date())
      });
      persistState();
      showToast(t("melavaRegSuccessToast"), "success");
      renderMemberPortal();
    }

