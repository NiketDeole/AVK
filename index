    function renderEditorialAboutChapters() {
      const about = state.settings.about;
      const rawInst = currentLang === "mr" ? about.instDescMr : about.instDescEn;
      const paras = String(rawInst || "").split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
      const pics = Array.isArray(state.settings.businessPicsFiles) && state.settings.businessPicsFiles.length
        ? state.settings.businessPicsFiles
        : ["pic1.jpg", "pic2.jpg", "pic3.jpg", "pic4.jpg", "pic5.jpg", "pic6.jpg"];

      // Split institution paragraphs cleanly across the 3 alternating Kanakavalli-inspired chapters
      const group1 = paras.slice(0, 2).length ? paras.slice(0, 2) : paras;
      const group2 = paras.slice(2, 4);
      const group3 = paras.slice(4);
      const chapterGroups = [group1, group2, group3];
      const meta = I18N[currentLang].editorialChapters;

      const grads = [
        "linear-gradient(135deg, #68283C 0%, #8f2245 55%, #B69A66 100%)",
        "linear-gradient(135deg, #4a0719 0%, #68283C 58%, #967638 100%)",
        "linear-gradient(135deg, #5c0b20 0%, #7f0e2c 52%, #B69A66 100%)"
      ];

      const container = document.getElementById("editorialStoryChapters");
      container.innerHTML = meta.map((ch, idx) => {
        const chParas = chapterGroups[idx] || [];
        if (!chParas.length) return "";
        const imgOnLeft = idx % 2 === 1;
        const picFile = pics[idx] || `pic${idx + 1}.jpg`;

        const textCol = `
          <div class="lg:col-span-6 p-6 sm:p-10 lg:p-12 flex flex-col justify-center bg-white ${imgOnLeft ? "reveal-right" : "reveal-left"}">
            <span class="text-[11px] font-extrabold uppercase tracking-[0.2em] text-gold-600">${escapeHtml(ch.eyebrow)}</span>
            <h4 class="font-serif text-2xl sm:text-[28px] font-bold text-brand-800 mt-2 leading-snug">${escapeHtml(ch.title)}</h4>
            <div class="w-12 h-[2px] bg-gold-500 my-4"></div>
            <div class="space-y-3 text-xs sm:text-sm text-stone-700 leading-relaxed">
              ${chParas.map((p) => `<p>${escapeHtml(p)}</p>`).join("")}
            </div>
